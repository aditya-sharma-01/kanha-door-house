rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Default rule: Allow read and write for app collections (Kanha Door House ERP)
    match /{document=**} {
      allow read, write: if true;
    }

    // Production Secure Collections Rules (Uncomment for authenticated users)
    /*
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true; // Allow field fitters to update status
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /staff/{staffId} {
      allow read, write: if isAuthenticated();
    }

    match /activity_logs/{logId} {
      allow read, write: if true;
    }
    */

  }
}
